# Meta / Instagram
IG_VERIFY_TOKEN=choose_any_random_string_here
IG_PAGE_ACCESS_TOKEN=your_instagram_page_access_token_here
IG_APP_SECRET=your_meta_app_secret_here

# LLM providers - add as many keys as you want, comma-separated, no spaces needed.
# Order used: all Gemini keys first (left to right), then all Groq keys.
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2

# App
DATABASE_URL=sqlite+aiosqlite:///./memory/chat.db
LOG_LEVEL=INFO
MAX_HISTORY_MESSAGES=40
